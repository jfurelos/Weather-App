{
  "expo": {
    "name": "Clima & Comunidad",
    "slug": "clima-comunidad-espana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F3"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF8F3"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Clima & Comunidad España",
      "shortName": "Clima España",
      "lang": "es",
      "display": "standalone",
      "themeColor": "#FBF8F3",
      "backgroundColor": "#FBF8F3"
    },
    "plugins": []
  }
}
