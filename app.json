{
  "expo": {
    "name": "Hoy qué?",
    "slug": "hoy-que",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/hoy_que_logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/hoy_que_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#335C67"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/hoy_que_logo.png",
        "backgroundColor": "#335C67"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/hoy_que_logo.png",
      "name": "Hoy qué?",
      "shortName": "Hoy qué?",
      "lang": "es",
      "display": "standalone",
      "themeColor": "#335C67",
      "backgroundColor": "#335C67"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
