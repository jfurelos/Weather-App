# Supabase Configuration (Free Tier)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# CARTO Basemaps API Key (Opcional, 100% gratuita en https://carto.com/basemaps/apikey)
# Si se deja vacía, la app usa automáticamente OpenStreetMap (100% abierta sin registro)
EXPO_PUBLIC_CARTO_API_KEY=
